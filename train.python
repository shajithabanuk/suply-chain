from flask import Flask, render_template, request
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import joblib

app = Flask(__name__)

# LOAD MODEL

model = joblib.load('model/model.pkl')

# LOAD DATASET

df = pd.read_csv(r'c:\Users\ELCOT\Downloads\dataset\Train.csv')

# PIE CHART

def create_pie_chart():

    delay_counts = df['Reached.on.Time_Y.N'].value_counts()

    labels = ['On-Time', 'Delayed']

    plt.figure(figsize=(5,5))

    plt.pie(
        delay_counts,
        labels=labels,
        autopct='%1.1f%%'
    )

    plt.title('Delivery Status')

    plt.savefig('static/pie_chart.png')

    plt.close()

# SHIPMENT BAR CHART

def create_bar_chart():

    shipment = df['Mode_of_Shipment'].value_counts()

    plt.figure(figsize=(6,4))

    plt.bar(
        shipment.index,
        shipment.values
    )

    plt.xlabel('Shipment Mode')

    plt.ylabel('Orders')

    plt.title('Shipment Analytics')

    plt.savefig('static/bar_chart.png')

    plt.close()

# CUSTOMER RATING CHART

def create_rating_chart():

    ratings = df['Customer_rating'].value_counts().sort_index()

    plt.figure(figsize=(6,4))

    plt.plot(
        ratings.index,
        ratings.values,
        marker='o'
    )

    plt.xlabel('Customer Rating')

    plt.ylabel('Count')

    plt.title('Customer Ratings')

    plt.savefig('static/rating_chart.png')

    plt.close()

# PRODUCT IMPORTANCE CHART

def create_importance_chart():

    importance = df['Product_importance'].value_counts()

    plt.figure(figsize=(6,4))

    plt.bar(
        importance.index,
        importance.values
    )

    plt.xlabel('Product Importance')

    plt.ylabel('Orders')

    plt.title('Product Importance Analytics')

    plt.savefig('static/importance_chart.png')

    plt.close()

# WAREHOUSE ANALYTICS

def create_warehouse_chart():

    warehouse_data = df.groupby(
        'Warehouse_block'
    )['Reached.on.Time_Y.N'].sum()

    plt.figure(figsize=(6,4))

    plt.bar(
        warehouse_data.index.astype(str),
        warehouse_data.values
    )

    plt.xlabel('Warehouse')

    plt.ylabel('Delayed Orders')

    plt.title('Warehouse Performance')

    plt.savefig('static/warehouse_chart.png')

    plt.close()

# TRANSPORT ANALYTICS

def create_transport_chart():

    transport = df.groupby(
        'Mode_of_Shipment'
    )['Weight_in_gms'].mean()

    plt.figure(figsize=(6,4))

    plt.plot(
        transport.index.astype(str),
        transport.values,
        marker='o'
    )

    plt.xlabel('Transport Type')

    plt.ylabel('Average Weight')

    plt.title('Transportation Analytics')

    plt.savefig('static/transport_chart.png')

    plt.close()

# GENERATE CHARTS

create_pie_chart()
create_bar_chart()
create_rating_chart()
create_importance_chart()
create_warehouse_chart()
create_transport_chart()

# HOME PAGE

@app.route('/')
def home():

    total_shipments = len(df)

    delayed_shipments = df['Reached.on.Time_Y.N'].sum()

    avg_discount = round(
        df['Discount_offered'].mean(),
        2
    )

    avg_rating = round(
        df['Customer_rating'].mean(),
        2
    )

    return render_template(
        'index.html',
        total_shipments=total_shipments,
        delayed_shipments=delayed_shipments,
        avg_discount=avg_discount,
        avg_rating=avg_rating
    )

# PREDICTION ROUTE

@app.route('/predict', methods=['POST'])
def predict():

    supplier_delay = float(
        request.form['supplier_delay']
    )

    warehouse_capacity = float(
        request.form['warehouse_capacity']
    )

    cargo_weight = float(
        request.form['cargo_weight']
    )

    transportation_delay = float(
        request.form['transportation_delay']
    )

    courier_rating = float(
        request.form['courier_rating']
    )

    delivery_distance = float(
        request.form['delivery_distance']
    )

    customer_rating = float(
        request.form['customer_rating']
    )

    features = np.array([[
        supplier_delay,
        warehouse_capacity,
        cargo_weight,
        transportation_delay,
        courier_rating
    ]])

    prediction = model.predict(features)

    if prediction[0] == 1:

        result = "Delayed Delivery"

    else:

        result = "On-Time Delivery"

    total_shipments = len(df)

    delayed_shipments = df['Reached.on.Time_Y.N'].sum()

    avg_discount = round(
        df['Discount_offered'].mean(),
        2
    )

    avg_rating = round(
        df['Customer_rating'].mean(),
        2
    )

    return render_template(
        'index.html',
        prediction=result,
        total_shipments=total_shipments,
        delayed_shipments=delayed_shipments,
        avg_discount=avg_discount,
        avg_rating=avg_rating
    )

# RUN FLASK

if __name__ == '__main__':

    app.run(debug=True)
